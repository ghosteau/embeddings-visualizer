# Copy to ".env" and adjust as needed. All values shown are the defaults.

# --- Environment ---
# "development" exposes /docs and enables auto-reload; "production" hides docs.
ENVIRONMENT=development

# --- Network ---
HOST=0.0.0.0
PORT=8000

# Optional compiled Vite folder. The production image sets this to /app/static.
STATIC_DIR=

# Compress JSON responses larger than this many bytes.
GZIP_MINIMUM_SIZE=1000

# Comma-separated list of allowed CORS origins (your frontend URLs).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Model cache ---
# Max distinct models resident in memory at once (LRU-evicted beyond this).
MAX_CACHED_MODELS=2
# Hard timeout for a single model load, in seconds.
MODEL_LOAD_TIMEOUT_SECONDS=180
# Number of most-frequent tokens to analyze per model (the point count).
# Higher = more vocabulary available to search/compare, but slower projection.
DEFAULT_TOP_N=6000
# Max cached UMAP projections per model.
MAX_CACHED_PROJECTIONS=8

# --- Preflight limits ---
# Checked against Hub metadata before any weights download, so an oversized
# model is refused in about a second instead of filling the disk. Lower these
# on a small host. The largest preset (gpt2-medium) needs 51M / ~1.5 GB.
# Embedding rows x columns. 250M params is roughly 1 GB as float32.
MAX_EMBEDDING_PARAMS=250000000
# Total bytes of weight files the repository may contain.
MAX_DOWNLOAD_BYTES=6000000000

# Optional allow-list of loadable Hugging Face model ids (comma-separated).
# Leave empty to allow any model. Recommended for public deployments.
ALLOWED_MODELS=
