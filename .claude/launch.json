{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "../.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "app.main"],
      "cwd": "backend",
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5173", "--host", "127.0.0.1"],
      "cwd": "frontend",
      "port": 5173,
      "autoPort": false
    }
  ]
}
